{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-11-15",
  // Static site only: Cloudflare serves the Vite build, no Worker code runs.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // For now the site lives at https://website.belaschinke.workers.dev.
  // Once belaschinke.com is on Cloudflare, switch to:
  //   "workers_dev": false,
  //   "routes": [
  //     { "pattern": "belaschinke.com", "custom_domain": true },
  //     { "pattern": "www.belaschinke.com", "custom_domain": true }
  //   ]
  "workers_dev": true
}
