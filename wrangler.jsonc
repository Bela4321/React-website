{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-11-15",
  // Static files from the Vite build; the small worker in front only redirects www.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "workers_dev": false,
  // ClusterSearch (/api/clustersearch): embeddings and question rewriting on Workers AI,
  // daily budgets and request spacing in one Durable Object, a per-visitor rate limit
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "CLUSTER_BUDGET", "class_name": "ClusterBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClusterBudget"] }],
  "ratelimits": [
    { "name": "CLUSTER_RATE", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
    { "name": "CLUSTER_NAMES_RATE", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "CONTACT_EMAIL": "api_usage@belaschinke.com" },
  // secrets (wrangler secret put): OPENALEX_API_KEY, S2_API_KEY
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "belaschinke.com", "custom_domain": true },
    { "pattern": "www.belaschinke.com", "custom_domain": true }
  ]
}
