{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-11-15",
  // Static files from the Vite build; the small worker in front only redirects www.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "belaschinke.com", "custom_domain": true },
    { "pattern": "www.belaschinke.com", "custom_domain": true }
  ]
}
